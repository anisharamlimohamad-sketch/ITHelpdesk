@model IEnumerable<ItHelpdesk.Models.IncidentReportViewModel>
@{
    ViewData["Title"] = "Track Status";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MIS Helpdesk</title>

    <!-- Bootstrap 5 & FontAwesome Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        body {
            background-color: #f1f5f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #334155;
        }

        /* Hero Header Bar */
        .hero-section {
            background: linear-gradient(135deg, #252478 0%, #1e1b4b 100%);
            color: white;
            padding: 30px 0 100px 0;
            margin-bottom: -70px;
        }

        .header-logo-box {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-portal-back {
            border: 1px solid rgba(255, 255, 255, 0.25);
            background: rgba(255, 255, 255, 0.08);
            color: white;
            border-radius: 50px;
            padding: 8px 22px;
            font-size: 0.9rem;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-portal-back:hover {
            background: rgba(255, 255, 255, 0.2);
            color: white;
        }

        /* Main Card Container */
        .track-card {
            background: white;
            border-radius: 28px;
            padding: 45px 50px;
            box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.05);
            margin-top: 10px;
        }

        .icon-box-green {
            width: 52px;
            height: 52px;
            border-radius: 16px;
            background-color: #e6fffa;
            color: #0d9488;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
        }

        /* Search Bar & Button Styling */
        .search-group-custom {
            position: relative;
            flex-grow: 1;
        }

        .search-group-custom .search-icon {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1.1rem;
            z-index: 5;
            pointer-events: none;
        }

        .input-search-custom {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 14px 20px 14px 50px;
            font-size: 0.95rem;
            color: #334155;
            width: 100%;
            transition: all 0.2s ease;
        }

        .input-search-custom:focus {
            background-color: #ffffff;
            border-color: #6366f1;
            outline: none;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }

        .btn-search-purple {
            background: #4f46e5;
            color: white;
            border-radius: 16px;
            padding: 0 35px;
            font-weight: 600;
            border: none;
            transition: all 0.2s ease;
        }

        .btn-search-purple:hover {
            background: #4338ca;
            color: white;
        }

        /* Ticket Status Card */
        .ticket-result-card {
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            padding: 30px;
            background-color: #ffffff;
        }

        .badge-status-pill {
            padding: 6px 18px;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .badge-status-pending {
            background-color: #fef3c7;
            color: #b45309;
        }

        .badge-status-progress {
            background-color: #e0f2fe;
            color: #0369a1;
        }

        .badge-status-resolved {
            background-color: #dcfce7;
            color: #15803d;
        }

        /* Step Progress Line Bar */
        .progress-step-container {
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 25px 40px 30px 40px;
        }

        .progress-step-line {
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 3px;
            background-color: #e2e8f0;
            z-index: 1;
            transform: translateY(-50%);
        }

        .progress-step-line-active {
            position: absolute;
            top: 50%;
            left: 0;
            height: 3px;
            background-color: #4f46e5;
            z-index: 2;
            transform: translateY(-50%);
            transition: width 0.3s ease;
        }

        .step-point {
            position: relative;
            z-index: 3;
            text-align: center;
            background: white;
        }

        .step-circle {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            border: 3px solid #cbd5e1;
            background-color: white;
            margin: 0 auto 8px auto;
            transition: all 0.3s ease;
        }

        .step-circle.active-solid {
            background-color: #4f46e5;
            border-color: #4f46e5;
        }

        .step-circle.active-halo {
            background-color: #e0f2fe;
            border: 4px solid #0284c7;
        }

        .step-circle.completed {
            background-color: #10b981;
            border-color: #10b981;
        }

        .step-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #64748b;
        }

        .step-label.active {
            color: #0f172a;
        }

        /* Comment Box Styling */
        .admin-comment-box {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 16px 20px;
            color: #334155;
            display: flex;
            align-items: center;
            gap: 12px;
        }
    </style>
</head>
<body>

    <!-- Header Section -->
    <div class="hero-section">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <div class="header-logo-box">
                    <i class="fa-solid fa-headset fa-lg"></i>
                </div>
                <h2 class="fw-bold mb-0 text-white">MIS Helpdesk</h2>
            </div>
            <a asp-action="UserPortal" class="btn-portal-back">
                <i class="fa-solid fa-arrow-left me-2"></i>Back to User Portal
            </a>
        </div>
    </div>

    <div class="container pb-5" style="position: relative; z-index: 10;">
        <div class="track-card">

            <!-- Title Header -->
            <div class="d-flex align-items-center gap-3 mb-2">
                <div class="icon-box-green">
                    <i class="fa-solid fa-magnifying-glass-chart"></i>
                </div>
                <h2 class="fw-bold text-dark mb-0">Track Status</h2>
            </div>
            <p class="text-muted mb-4" style="margin-left: 68px;">
                Check the real-time progress of your ticket without contacting the IT team.
            </p>

            <!-- Search Form -->
            <form asp-action="TrackStatus" method="get" class="mb-2">
                <div class="d-flex gap-3 mb-2">
                    <div class="search-group-custom">
                        <i class="fa-solid fa-magnifying-glass search-icon"></i>
                        <input type="text" name="searchQuery" value="@ViewData["Query"]" class="input-search-custom" placeholder="Input Employee ID or Asset Name..." required />
                    </div>
                    <button type="submit" class="btn-search-purple">Search</button>
                </div>
                <p class="text-muted small mb-4">Use the Employee ID or Asset Name you entered when submitting your ticket.</p>
            </form>

            <!-- Results Section -->
            @if (Model != null && Model.Any())
            {
                <div class="d-flex flex-column gap-4">
                    @foreach (var item in Model)
                    {
                        var status = item.Status ?? "Pending";
                        int progressPercent = status == "Resolved" ? 100 : (status == "In Progress" ? 50 : 0);

                        <div class="ticket-result-card">
                            
                            <!-- Card Header Row with Status Badge -->
                            <div class="d-flex justify-content-between align-items-center pb-2 border-bottom">
                                <span class="fw-bold text-dark">Ticket Status</span>
                                <div>
                                    @if (status == "Resolved")
                                    {
                                        <span class="badge-status-pill badge-status-resolved">
                                            <i class="fa-solid fa-circle fa-2xs"></i> Resolved
                                        </span>
                                    }
                                    else if (status == "In Progress")
                                    {
                                        <span class="badge-status-pill badge-status-progress">
                                            <i class="fa-solid fa-circle fa-2xs"></i> In Progress
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status-pill badge-status-pending">
                                            <i class="fa-solid fa-circle fa-2xs"></i> Pending
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Visual Step Progress Bar -->
                            <div class="progress-step-container">
                                <div class="progress-step-line"></div>
                                <div class="progress-step-line-active" style="width: @progressPercent%;"></div>

                                <!-- Step 1: Submitted -->
                                <div class="step-point">
                                    <div class="step-circle active-solid"></div>
                                    <div class="step-label active">Submitted</div>
                                </div>

                                <!-- Step 2: In Progress -->
                                <div class="step-point">
                                    <div class="step-circle @(status == "In Progress" ? "active-halo" : (status == "Resolved" ? "completed" : ""))"></div>
                                    <div class="step-label @(status == "In Progress" || status == "Resolved" ? "active" : "")">In Progress</div>
                                </div>

                                <!-- Step 3: Resolved -->
                                <div class="step-point">
                                    <div class="step-circle @(status == "Resolved" ? "completed" : "")"></div>
                                    <div class="step-label @(status == "Resolved" ? "active" : "")">Resolved</div>
                                </div>
                            </div>

                            <!-- Separated Details Row (Employee ID, Asset Name, Department) -->
                            <div class="row g-4 mb-3">
                                <div class="col-md-4">
                                    <span class="text-muted small d-block mb-1">Employee ID</span>
                                    <h6 class="fw-bold text-dark mb-0">@(string.IsNullOrEmpty(item.EmployeeId) ? "-" : item.EmployeeId)</h6>
                                </div>
                                <div class="col-md-4">
                                    <span class="text-muted small d-block mb-1">Asset Name</span>
                                    <h6 class="fw-bold text-dark mb-0">@(string.IsNullOrEmpty(item.AssetName) ? "-" : item.AssetName)</h6>
                                </div>
                                <div class="col-md-4">
                                    <span class="text-muted small d-block mb-1">Department</span>
                                    <h6 class="fw-bold text-dark mb-0">@(string.IsNullOrEmpty(item.Department) ? "-" : item.Department)</h6>
                                </div>
                            </div>

                            <!-- Problem Description -->
                            <div class="mb-4">
                                <span class="text-muted small d-block mb-1">Problem</span>
                                <h6 class="fw-bold text-dark mb-0">@item.ProblemDescription</h6>
                            </div>

                            <!-- Admin Comments Row -->
                            <div>
                                <span class="text-muted small d-block mb-2">Admin Comments / Updates</span>
                                <div class="admin-comment-box">
                                    <i class="fa-regular fa-comment text-primary"></i>
                                    <span>
                                        @if (string.IsNullOrWhiteSpace(item.AdminComments))
                                        {
                                            <em class="text-muted">- No comment yet -</em>
                                        }
                                        else
                                        {
                                            @item.AdminComments
                                        }
                                    </span>
                                </div>
                            </div>

                        </div>
                    }
                </div>
            }
            else if (ViewData["Query"] != null)
            {
                <div class="alert alert-warning rounded-4 p-4 mt-3" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> No incident or request records found matching <strong>"@ViewData["Query"]"</strong>.
                </div>
            }

        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>