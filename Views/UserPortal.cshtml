@{
    ViewData["Title"] = "MIS Helpdesk Portal";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5 & FontAwesome Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
            body {
                background-color: #f1f5f9;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                color: #334155;
            }

            /* Hero Banner Header */
            .hero-section {
                background: linear-gradient(135deg, #252478 0%, #1e1b4b 100%);
                color: white;
                padding: 30px 0 100px 0;
                margin-bottom: -70px;
            }

            .header-logo-box {
                width: 46px;
                height: 46px;
                border-radius: 12px;
                background: rgba(255, 255, 255, 0.12);
                display: flex;
                align-items: center;
                justify-content: center;
            }

            /* Admin Login Pill */
            .btn-admin-login {
                border: 1px solid rgba(255, 255, 255, 0.25);
                background: rgba(255, 255, 255, 0.08);
                color: white;
                border-radius: 50px;
                padding: 8px 22px;
                font-size: 0.9rem;
                text-decoration: none;
                transition: all 0.2s ease;
            }

                .btn-admin-login:hover {
                    background: rgba(255, 255, 255, 0.2);
                    color: white;
                }

            /* Option Cards (Landing View) */
            .option-card {
                border: none;
                border-radius: 24px;
                transition: all 0.3s ease;
                background: white;
                box-shadow: 0 10px 25px -5px rgba(0,0,0,0.04);
                padding: 24px 20px;
                cursor: pointer;
            }

                .option-card:hover {
                    transform: translateY(-6px);
                    box-shadow: 0 18px 30px -10px rgba(0,0,0,0.08);
                }

            .icon-box {
                width: 56px;
                height: 56px;
                border-radius: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.35rem;
                margin-bottom: 20px;
            }

            .icon-red {
                background-color: #fef2f2;
                color: #ef4444;
            }

            .icon-blue {
                background-color: #e0e7ff;
                color: #4f46e5;
            }

            .icon-green {
                background-color: #ecfdf5;
                color: #10b981;
            }

            .btn-custom-red {
                background-color: #ef4444;
                color: white;
                border-radius: 50px;
                padding: 12px 20px;
                font-weight: 600;
                border: none;
            }

            .btn-custom-blue {
                background-color: #4f46e5;
                color: white;
                border-radius: 50px;
                padding: 12px 20px;
                font-weight: 600;
                border: none;
            }

            .btn-custom-green {
                background-color: #0d9488;
                color: white;
                border-radius: 50px;
                padding: 12px 20px;
                font-weight: 600;
                border: none;
            }

            /* Form Card Container */
            .form-container {
                display: none;
                background: white;
                border-radius: 28px;
                padding: 45px 50px;
                box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.05);
                margin-top: 10px;
            }

            .active-form {
                display: block;
                animation: fadeIn 0.35s ease-in-out;
            }

            @@keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(8px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* Custom Input Styling with Inner Icons */
            .input-group-custom {
                position: relative;
            }

                .input-group-custom .input-icon {
                    position: absolute;
                    left: 18px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #64748b;
                    font-size: 1.05rem;
                    z-index: 5;
                    pointer-events: none;
                }

            .form-control-custom, .form-select-custom {
                background-color: #f8fafc;
                border: 1px solid #e2e8f0;
                border-radius: 16px;
                padding: 13px 18px 13px 48px;
                font-size: 0.95rem;
                color: #334155;
                transition: all 0.2s ease;
            }

                .form-control-custom:focus, .form-select-custom:focus {
                    background-color: #ffffff;
                    border-color: #6366f1;
                    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
                }

            .textarea-custom {
                background-color: #f8fafc;
                border: 1px solid #e2e8f0;
                border-radius: 16px;
                padding: 18px;
                font-size: 0.95rem;
                color: #334155;
                transition: all 0.2s ease;
            }

                .textarea-custom:focus {
                    background-color: #ffffff;
                    border-color: #6366f1;
                    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
                }

            .btn-submit-purple {
                background: #4f46e5;
                color: white;
                border-radius: 50px;
                padding: 12px 30px;
                font-weight: 600;
                border: none;
                box-shadow: 0 8px 18px -4px rgba(79, 70, 229, 0.4);
                transition: all 0.2s ease;
            }

                .btn-submit-purple:hover {
                    background: #4338ca;
                    color: white;
                    transform: translateY(-1px);
                }

            .btn-back-pill {
                border: 1px solid #e2e8f0;
                background: white;
                color: #475569;
                border-radius: 50px;
                padding: 8px 20px;
                font-weight: 500;
                text-decoration: none;
                transition: all 0.2s ease;
            }

                .btn-back-pill:hover {
                    background: #f1f5f9;
                    color: #0f172a;
                }
    </style>
</head>
<body>

    <!-- Hero Header -->
    <div class="hero-section">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <div class="header-logo-box">
                    <i class="fa-solid fa-headset fa-lg"></i>
                </div>
                <h2 class="fw-bold mb-0 text-white">MIS Helpdesk</h2>
            </div>
            <a asp-action="AdminDashboard" class="btn-admin-login">
                <i class="fa-solid fa-lock me-2"></i>Admin login
            </a>
        </div>
    </div>

    <div class="container pb-5" style="position: relative; z-index: 10;">

        <!-- Success Notifications -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm mt-3" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["MisSuccess"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm mt-3" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i> @TempData["MisSuccess"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- DASHBOARD SELECTION CARDS -->
        <div id="selection-dashboard" class="row g-4 justify-content-center pt-4">

            <!-- Option 1: Request Support -->
            <div class="col-md-4">
                <div class="option-card h-100 d-flex flex-column justify-content-between" onclick="showForm('incident-form')">
                    <div>
                        <div class="icon-box icon-red">
                            <i class="fa-solid fa-wrench"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">Request Support</h4>
                        <p class="text-muted small mb-4">Report hardware failures, internet network issues or IT software problems.</p>
                    </div>
                    <button class="btn btn-custom-red w-100 d-flex justify-content-between align-items-center px-4">
                        <span>Request Ticket</span>
                        <i class="fa-solid fa-chevron-right small"></i>
                    </button>
                </div>
            </div>

            <!-- Option 2: MIS Request -->
            <div class="col-md-4">
                <div class="option-card h-100 d-flex flex-column justify-content-between" onclick="showForm('mis-form')">
                    <div>
                        <div class="icon-box icon-blue">
                            <i class="fa-solid fa-laptop"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">MIS Request</h4>
                        <p class="text-muted small mb-4">Request new laptops, hardware equipment or equipment upgrades.</p>
                    </div>
                    <button class="btn btn-custom-blue w-100 d-flex justify-content-between align-items-center px-4">
                        <span>Make a request</span>
                        <i class="fa-solid fa-chevron-right small"></i>
                    </button>
                </div>
            </div>

            <!-- Option 3: Track Status -->
            <div class="col-md-4">
                <div class="option-card h-100 d-flex flex-column justify-content-between" onclick="showForm('track-form')">
                    <div>
                        <div class="icon-box icon-green">
                            <i class="fa-solid fa-magnifying-glass-chart"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">Track Status</h4>
                        <p class="text-muted small mb-4">Check the real-time progress of your tickets or requests.</p>
                    </div>
                    <button class="btn btn-custom-green w-100 d-flex justify-content-between align-items-center px-4">
                        <span>Check status</span>
                        <i class="fa-solid fa-chevron-right small"></i>
                    </button>
                </div>
            </div>

        </div>


        <!-- FORM 1: SUBMIT IT INCIDENT REPORT -->
        <div id="incident-form" class="form-container">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-box icon-red mb-0" style="width: 52px; height: 52px;">
                        <i class="fa-solid fa-wrench"></i>
                    </div>
                    <h2 class="fw-bold text-dark mb-0">Submit IT Incident Report</h2>
                </div>
                <button type="button" class="btn btn-back-pill" onclick="goBackToDashboard()">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back
                </button>
            </div>

            
            <p class="text-muted mb-4 pb-2" style="margin-left: 68px;">
                Fill the details and MIS team will review your request.
            </p>

            <form asp-action="SubmitIncident" method="post">
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">Employee ID</label>
                        <div class="input-group-custom">
                            <i class="fa-solid fa-id-card-clip input-icon"></i>
                            <input type="text" name="EmployeeId" class="form-control form-control-custom" placeholder="E.g., MW12345" required />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">Asset Name</label>
                        <div class="input-group-custom">
                            <i class="fa-solid fa-desktop input-icon"></i>
                            <input type="text" name="AssetName" class="form-control form-control-custom" placeholder="E.g., NGKPC000" required />
                        </div>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">Department</label>
                        <div class="input-group-custom">
                            <i class="fa-solid fa-building input-icon"></i>
                            <input type="text" name="Department" class="form-control form-control-custom" placeholder="E.g., Finance / HR" required />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">Issue Category</label>
                        <div class="input-group-custom">
                            <i class="fa-solid fa-layer-group input-icon"></i>
                            <select name="Category" class="form-select form-select-custom">
                                <option>Laptop</option>
                                <option>Internet / Network</option>
                                <option>Printer</option>
                                <option>Software / Access</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-dark mb-2">Problem Description</label>
                    <textarea name="ProblemDescription" rows="4" class="form-control textarea-custom" placeholder="Describe the issue in detail..." required></textarea>
                </div>

                <div class="d-flex align-items-center gap-4 pt-2">
                    <button type="submit" class="btn btn-submit-purple d-flex align-items-center gap-2">
                        <span>Submit incident ticket</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </form>
        </div>


        <!-- FORM 2: MIS EQUIPMENT REQUEST -->
        <div id="mis-form" class="form-container">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-box icon-blue mb-0" style="width: 52px; height: 52px;">
                        <i class="fa-solid fa-laptop"></i>
                    </div>
                    <h2 class="fw-bold text-dark mb-0">MIS Equipment Request</h2>
                </div>
                <button type="button" class="btn btn-back-pill" onclick="goBackToDashboard()">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back
                </button>
            </div>

            <p class="text-muted mb-4 pb-2" style="margin-left: 68px;">
                Fill the details for the equipments.
            </p>

            <form asp-action="SubmitMis" method="post">
                <div class="mb-4">
                    <label class="form-label fw-bold text-dark mb-2">Requester Employee ID</label>
                    <div class="input-group-custom">
                        <i class="fa-solid fa-id-card input-icon"></i>
                        <input type="text" name="RequesterEmployeeId" class="form-control form-control-custom" placeholder="E.g., EMP-102" required />
                    </div>
                </div>
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">Department</label>
                        <div class="input-group-custom">
                            <i class="fa-solid fa-building input-icon"></i>
                            <input type="text" name="Department" class="form-control form-control-custom" placeholder="E.g., Engineering" required />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">Request Type</label>
                        <div class="input-group-custom">
                            <i class="fa-solid fa-laptop input-icon"></i>
                            <select name="RequestType" class="form-select form-select-custom">
                                <option>New Laptop</option>
                                <option>Hardware Upgrade</option>
                                <option>Peripherals (Mouse, Keyboard, Monitor)</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">New Hire Name (if applicable)</label>
                        <div class="input-group-custom">
                            <i class="fa-solid fa-user-plus input-icon"></i>
                            <input type="text" name="NewHireName" class="form-control form-control-custom" placeholder="New employee name" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">Needed Date</label>
                        <div class="input-group-custom">
                            <i class="fa-solid fa-calendar-days input-icon"></i>
                            <input type="date" name="NeededDate" class="form-control form-control-custom" required />
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-4 pt-2">
                    <button type="submit" class="btn btn-submit-purple d-flex align-items-center gap-2">
                        <span>Submit MIS request</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </form>
        </div>


        <!-- FORM 3: TRACK REQUEST STATUS -->
        <div id="track-form" class="form-container">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-box icon-green mb-0" style="width: 52px; height: 52px;">
                        <i class="fa-solid fa-magnifying-glass-chart"></i>
                    </div>
                    <h2 class="fw-bold text-dark mb-0">Track Request & Status</h2>
                </div>
                <button type="button" class="btn btn-back-pill" onclick="goBackToDashboard()">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back
                </button>
            </div>

            <p class="text-muted mb-4 pb-2" style="margin-left: 68px;">
                Check request ticket or report directly.
            </p>

            <form asp-action="TrackStatus" method="get" class="mb-4">
                <div class="mb-4">
                    <label class="form-label fw-bold text-dark mb-2">Search Query</label>
                    <div class="input-group-custom">
                        <i class="fa-solid fa-magnifying-glass input-icon"></i>
                        <input type="text" name="searchQuery" class="form-control form-control-custom" placeholder="Enter Employee ID or Asset Name (E.g., NGKPC000)..." required />
                    </div>
                </div>

                <button type="submit" class="btn btn-submit-purple d-flex align-items-center gap-2">
                    <span>Search status</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </form>

            <div class="text-muted small">
                <i class="fa-solid fa-circle-info me-1"></i> Enter search details to view real-time status updates and notes from the IT Admin team.
            </div>
        </div>

    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            function showForm(formId) {
                document.getElementById('selection-dashboard').style.display = 'none';
                document.querySelectorAll('.form-container').forEach(el => {
                    el.classList.remove('active-form');
                });
                document.getElementById(formId).classList.add('active-form');
                window.scrollTo({ top: 120, behavior: 'smooth' });
            }

            function goBackToDashboard() {
                document.querySelectorAll('.form-container').forEach(el => {
                    el.classList.remove('active-form');
                });
                document.getElementById('selection-dashboard').style.display = 'flex';
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
    </script>
</body>
</html>